# Nu management agent configuration.
# Broker used for provisioning announce + remote setConfig (same broker as the converter EXT path).
NU_BROKER_HOST=tbmq.nuteknoloji.com
NU_BROKER_PORT=5859

# Certificate used to authenticate (default = baked bootstrap cert; replaced over SSH per customer).
NU_CA_CERT=/etc/nu/certs/ca.pem
NU_CERTFILE=/etc/nu/certs/device.pem
NU_KEYFILE=/etc/nu/certs/device-key.pem

# How often (seconds) to publish the announce beacon while not provisioned.
NU_ANNOUNCE_INTERVAL=30
# How long (seconds) to wait for broker connectivity after applying a new config
# before rolling back to the last-known-good config.
NU_VERIFY_TIMEOUT=180
